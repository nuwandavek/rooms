# Hosting for `kit/home deploy <project>` (copy to .env; .env is gitignored).
# Each home is served at $ROOMS_ORIGIN/<project>/ from s3://$ROOMS_BUCKET/$ROOMS_PREFIX/<project>/.
# kit/hosting/setup.sh creates the CloudFront distribution once and fills in the last two.
ROOMS_BUCKET=isopolis
ROOMS_PREFIX=rooms
AWS_REGION=us-west-1
ROOMS_ORIGIN=https://rooms.isopolis.city
ROOMS_DISTRIBUTION_ID=
ROOMS_CLOUDFRONT_DOMAIN=
